{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32: Build, Upload and Reset",
            "type": "process",
            "command": "pio",
            "windows": {
                "command": "${env:USERPROFILE}/.platformio/penv/Scripts/pio.exe"
            },
            "args": ["run", "--environment", "stm32f103c8", "--target", "upload"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
